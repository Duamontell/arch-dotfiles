{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/weather",
        "niri/language",
        "clock"
    ],

    // --- Модули слева ---
    "niri/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "󰈹", // браузер
            "2": "󰆍", // терминал
            "3": "󰨞", // код
            "4": "󰍡", // чат
            "5": "󰌾", // пароли
            "6": "󰉋", // файлы
            "7": "󰝚", // медиа
            "8": "󰒓", // система
            "urgent": "",
            "default": "󰄯"
        }
    },

    // --- Модули по центру ---
    "niri/window": {
        // app_id нужен, чтобы всегда показывать kitty вместо заголовка
        // с текущим файлом/директорией. Первое правило убирает префикс app_id.
        "format": "{app_id}|{title}",
        "max-length": 45,
        "separate-outputs": true,
        "rewrite": {
            "^(?:(kitty)[|][\\s\\S]*|[\\s\\S]*?[|]([\\s\\S]*))$": "$1$2",
            "^.* — Mozilla Firefox$": "Firefox 󰈹",
            "^.* - Visual Studio Code$": "VS Code 󰨞",
            "^.* - Alacritty$": "Alacritty 󰆍"
        }
    },

    // --- Модули справа ---
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-linked": "󰈀  {ifname}",
        "format-disconnected": "󰤭  Offline",
        "format-disabled": "󰤮  Wi-Fi off",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format-wifi": "{essid}\n{signalStrength}%  {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Нет подключения",
        "on-click": "kitty nmtui"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱  {device_alias}",
        "format-no-controller": "󰂲",
        "tooltip-format": "{controller_alias}\n{controller_address}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "on-click": "kitty bluetoothctl",
        "on-click-right": "bluetoothctl power toggle"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "󰂱  {volume}%",
        "format-muted": "󰖁  muted",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "bat": "BAT1",
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰂄  {capacity}%",
        "format-full": "󰁹  {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{time}\n{power} W  {capacity}%"
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 900,
        // Первая строка — текст модуля, вторая — подробности в tooltip.
        "exec": "curl -fsS --max-time 10 'https://wttr.in/?format=%c%t%0A%C+%7C+Feels+like+%f+%7C+Humidity+%h+%7C+Wind+%w' || printf '󰖐 --°C\\nПогода недоступна'; echo"
    },

    "niri/language": {
        "format": "󰌌  {}",
        "format-en": "EN",
        "format-ru": "RU",
        "keyboard-name": "at-translated-set-2-keyboard" // Укажите имя своей клавиатуры, если отличается
    },

    "clock": {
        "interval": 1,
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d %B %Y (%H:%M:%S)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#bb9af7'><b>{}</b></span>",
                "days":       "<span color='#c0caf5'><b>{}</b></span>",
                "weeks":      "<span color='#7dcfff'><b>W{}</b></span>",
                "weekdays":   "<span color='#ff9e64'><b>{}</b></span>",
                "today":      "<span color='#f7768e'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    }
}
