{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "custom/weather",
        "hyprland/language",
        "clock"
    ],

    // --- Модули слева ---
    "niri/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "urgent": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 4
        }
    },

    // --- Модули по центру ---
    "niri/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true,
        "rewrite": {
            "^$": "Desktop",
            "(.*) — Mozilla Firefox": "Firefox 󰈹",
            "(.*) - Visual Studio Code": "VS Code 󰨞",
            "(.*) - Alacritty": "Terminal ",
            "(.*) - Kitty": "Terminal 󰄛"
        }
    },

    // --- Модули справа ---
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 900,
        "exec": "python3 ~/.config/waybar/scripts/weather.py",
        "return-type": "json"
    },

    "niri/language": {
        "format": "󰌌  {}",
        "format-en": "EN",
        "format-ru": "RU",
        "keyboard-name": "at-translated-set-2-keyboard" // Укажите имя своей клавиатуры, если отличается
    },

    "clock": {
        "interval": 1,
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d %B %Y (%H:%M:%S)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#bb9af7'><b>{}</b></span>",
                "days":       "<span color='#c0caf5'><b>{}</b></span>",
                "weeks":      "<span color='#7dcfff'><b>W{}</b></span>",
                "weekdays":   "<span color='#ff9e64'><b>{}</b></span>",
                "today":      "<span color='#f7768e'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    }
}
