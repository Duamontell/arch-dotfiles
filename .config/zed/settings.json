// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "inline_code_actions": true,
  "relative_line_numbers": "disabled",
  "gutter": {
    "min_line_number_digits": 4,
    "runnables": true,
    "line_numbers": true
  },
  "hover_popover_enabled": true,
  "auto_signature_help": true,
  "git_panel": {
    "button": true
  },
  "outline_panel": {
    "button": true
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0
  },
  "window_title_format": "${projectName}${separator}${fileName}",
  "focus_follows_mouse": {
    "enabled": false
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_preview_from_file_finder": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true
  },
  "terminal": {
    "starts_open": false,
    "show_count_badge": false,
    "button": true
  },
  "status_bar": {
    "show_active_file": false,
    "pending_keystrokes_indicator": true,
    "line_endings_button": false,
    "cursor_position_button": true,
    "active_language_button": true
  },
  "buffer_line_height": "comfortable",
  "title_bar": {
    "open_menus_on_hover": false,
    "button_layout": "platform_default",
    "show_menus": false,
    "show_branch_name": true
  },
  "project_panel": {
    "button": true,
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "git_status": true,
    "folder_indicator": "icon",
    "file_icons": true,
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
    "default_width": 250.0,
    "dock": "left"
  },
  "git": {
    "diff_base": "head"
  },
  "proxy": "",
  "autosave": {
    "after_delay": {
      "milliseconds": 2000
    }
  },
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains New UI Icons (Dark)",
    "dark": "Base Charmed Icons"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Duskfox - opaque",
    "dark": "Kanagawa Dragon"
  },
}
