{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low"
  },
  "attention": {
    "notifications": true
  },
  "theme": {
    "mode": "dark"
  },
  "tabs": {
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "debug": {
    "devtools": true
  },
  "experimental": {
    "client-mcp": true,
    "new-designs": false
  },
  "prompt": {
    "image_preview": false
  }
}
